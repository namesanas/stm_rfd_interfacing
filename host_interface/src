#include "host_interface.h"

#include <string.h>

#define HOST_RX_BUFFER_SIZE 128U
#define HOST_RX_QUEUE_SIZE  256U

extern volatile uint8_t hostRxQueue[HOST_RX_QUEUE_SIZE];
extern volatile uint16_t hostRxHead;
extern volatile uint16_t hostRxTail;
extern volatile uint16_t hostRxCount;
extern volatile uint32_t hostRxOverflow;

static char hostRxBuffer[HOST_RX_BUFFER_SIZE];
static uint16_t hostRxIndex = 0U;

void HOST_Interface_Init(void)
{
    hostRxIndex = 0U;
    memset(hostRxBuffer, 0, sizeof(hostRxBuffer));
}

void HOST_Interface_Task(void)
{
    while(hostRxCount > 0U)
    {
        uint8_t byte;

        byte = hostRxQueue[hostRxTail];

        hostRxTail++;

        if(hostRxTail >= HOST_RX_QUEUE_SIZE)
        {
            hostRxTail = 0U;
        }

        hostRxCount--;

        if(hostRxIndex < (HOST_RX_BUFFER_SIZE - 1U))
        {
            hostRxBuffer[hostRxIndex] = (char)byte;
            hostRxIndex++;
        }

        if(byte == '\n')
        {
            hostRxBuffer[hostRxIndex] = '\0';

            /* Command parser comes next. */

            hostRxIndex = 0U;
        }
    }
}
